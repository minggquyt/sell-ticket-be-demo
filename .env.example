# -----------------------------------------------------------------------------
# Database (required)
# PostgreSQL/Supabase connection string. URL-encode special characters in the
# username or password. On Heroku, use the IPv4 Supabase Pooler (:6543).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MAX=15

# -----------------------------------------------------------------------------
# Authentication (required unless noted otherwise)
# Generate independent secrets, for example: openssl rand -hex 32
# Never reuse JWT_SECRET as OTP_HMAC_SECRET.
# JWT_EXPIRES_IN accepts jsonwebtoken durations such as 1d, 12h, or 20m.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1d
OTP_HMAC_SECRET=replace-with-a-different-long-random-otp-secret

# -----------------------------------------------------------------------------
# Registration OTP policy (optional; values below are application defaults)
# -----------------------------------------------------------------------------
OTP_TTL_SECONDS=300
REGISTRATION_TTL_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# -----------------------------------------------------------------------------
# Email OTP delivery
# Production: use gmail and configure all Gmail fields below.
# Local-only alternative: EMAIL_PROVIDER=console. The console provider does not
# print OTP values and is rejected when NODE_ENV=production.
# Create a Google App Password after enabling 2-Step Verification; do not use
# the normal Google account password.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=gmail
EMAIL_FROM="Ticket App <your-email@gmail.com>"
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# -----------------------------------------------------------------------------
# PayOS payment gateway
# Required for checkout/payment. The server can start without these values,
# but payment operations will be disabled.
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# -----------------------------------------------------------------------------
# Server/runtime
# FRONTEND_ORIGIN is required in production (no trailing '/') to build PayOS
# return/cancel URLs and is automatically included in the CORS allowlist.
# CORS_ORIGINS: comma-separated allowed origins; leave empty for '*' fallback.
# ENABLE_LIVE_LOGS defaults to false when NODE_ENV=production.
# LOGS_ACCESS_TOKEN protects /logs and /api/logs/stream when live logs are enabled.
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ENABLE_LIVE_LOGS=true
LOGS_ACCESS_TOKEN=
